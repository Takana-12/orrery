{
  "name": "orrery",
  "private": true,
  "version": "0.8.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#core": "./packages/core/src/index.ts",
    "#provider-claude": "./packages/provider-claude/src/index.ts",
    "#provider-codex": "./packages/provider-codex/src/index.ts",
    "#host": "./packages/host/src/index.ts"
  },
  "scripts": {
    "start": "node packages/server/src/main.ts",
    "test": "node --test \"packages/**/*.test.ts\" \"packages/**/*.test.mjs\" \"apps/desktop/*.test.mjs\"",
    "test:knowledge-ui": "electron packages/server/test/knowledge-ui.mjs",
    "test:update-ui": "electron packages/server/test/update-ui.mjs",
    "test:voice-ui": "electron packages/server/test/voice-ui.mjs",
    "typecheck": "tsc --noEmit",
    "e2e": "node packages/server/test/e2e.ts && node packages/server/test/e2e-supervisors.ts",
    "app": "electron .",
    "icons": "node apps/desktop/make-icons.mjs",
    "package": "node apps/desktop/package.mjs",
    "install-app": "node apps/desktop/install.mjs",
    "smoke": "node scripts/smoke-packaged.mjs",
    "screenshots": "electron scripts/readme-screenshots.mjs",
    "sync-public": "node scripts/sync-public.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "koffi": "^3.3.8",
    "sherpa-onnx-node": "2.0.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "electron": "^45.4.1",
    "typescript": "^5.9.0"
  },
  "main": "apps/desktop/main.mjs",
  "productName": "Orrery"
}
